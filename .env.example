# =============================================================================
#  Suraj AI — Environment configuration
#  Copy this file to `.env` and fill in your values.
# =============================================================================

# ---- Access control (recommended for shared use) -------------------------
# Set a password to protect the dashboard when sharing on a network.
# Leave empty to disable (open access — fine for personal/local use).
# SURAJ_PASSWORD=mypassword123

# ---- LLM (optional) -------------------------------------------------------
# Enables free-form natural language understanding and screen analysis.
# If not set, the AI uses a built-in rule-based engine (works offline).
# Works with any OpenAI-compatible API (OpenAI, Azure, OpenRouter, Ollama, etc.)
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# ---- Server ---------------------------------------------------------------
# HOST=0.0.0.0
# PORT=8000

# ---- ADB (optional defaults) ---------------------------------------------
# Pre-fill a device serial or wireless host so you don't need to connect
# manually each time.
# ADB_SERIAL=
# ADB_HOST=192.168.1.50:5555
